# Keep the build context small and the image reproducible.
.venv/
.tmp/
.pipcache/
.npmcache/
__pycache__/
**/__pycache__/
.pytest_cache/
backend/data/
# The face models are committed and must go into the image, and so is the
# manifest once training has produced a real one -- detector.py reads it for
# the per-model metrics the Models page shows. Only the untrained placeholder
# is excluded.
backend/models/dummy_testnet*
backend/tests/
frontend/node_modules/
frontend/dist/
brand/
notebooks/
training/
tools/
.git/
*.md
