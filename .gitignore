# Python
__pycache__/
*.py[cod]
.venv/
.venv-local/
.pytest_cache/
.pytest-run-*/

# Local scratch space (this project keeps temp on D: because C: is full)
.tmp/
.pipcache/
.npmcache/

# Node
node_modules/
frontend/dist/

# Runtime data
backend/data/
*.corrupt-*.db

# Models.
#
# The face models (YuNet 0.2 MB + SFace 38 MB) ARE committed, so a fresh clone
# — or a container built from one — can detect and recognise faces with no
# download step. They are Apache-2.0 from OpenCV Zoo and well inside GitHub's
# 100 MB per-file limit.
#
# The deepfake classifiers are NOT committed: they come out of the Colab
# training run and are specific to each training. Drop them into
# backend/models/ and they are picked up automatically.
backend/models/*.onnx
backend/models/*.onnx.data
backend/models/*.npy
backend/models/manifest.json
backend/models/metrics/
!backend/models/face_detection_yunet.onnx
!backend/models/face_recognition_sface.onnx

# Training artifacts
out/
omniguard_models.zip

# OS / editor noise
Thumbs.db
desktop.ini
.DS_Store
*.swp
